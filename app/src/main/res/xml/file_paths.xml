<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exposes the app-specific impulse directory (context.filesDir/impulse) so
         the in-app "Send logs" action can hand a content:// URI to share apps
         without exposing the rest of the app's internal storage. -->
    <files-path
        name="impulse_logs"
        path="impulse/" />
</paths>

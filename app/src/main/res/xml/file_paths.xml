<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exposes the app-specific logs directory (context.filesDir/logs) so the
         in-app "Open folder" action can hand a content:// URI to a file manager
         without exposing the rest of the app's internal storage. -->
    <files-path
        name="logs"
        path="logs/" />
</paths>
